STOCKS_HOST=127.0.0.1
STOCKS_PORT=8790
STOCKS_DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/stocks_data

STOCKS_PROVIDER_PRIMARY=ssi
STOCKS_PROVIDER_FALLBACK=vnstock
STOCKS_REQUEST_TIMEOUT=15
STOCKS_DEFAULT_LIMIT=300
STOCKS_MAX_LIMIT=2000
STOCKS_MIN_PREPARED_CANDLES=100

SSI_CONSUMER_ID=YOUR_CONSUMER_ID
SSI_CONSUMER_SECRET=YOUR_CONSUMER_SECRET
SSI_PUBLIC_KEY=
SSI_PRIVATE_KEY=
SSI_REQUEST_TIMEOUT=20
SSI_REQUEST_RETRIES=2
SSI_RETRY_DELAY_SECONDS=1
SSI_SECURITIES_CACHE_SECONDS=300

# v0.2.5 corporate-action auto reconciliation.
# SSI detects factor transitions and supplies canonical adjusted DailyOhlc.
STOCKS_CORPORATE_ACTION_AUTO=true
STOCKS_CORPORATE_ACTION_LOOKBACK_DAYS=45
STOCKS_CORPORATE_ACTION_FACTOR_TOLERANCE=0.0005
# Price unit is thousand VND; 0.05 = 50 VND.
STOCKS_CORPORATE_ACTION_PRICE_TOLERANCE=0.05
