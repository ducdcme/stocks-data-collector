# VN Stocks Data Collector local configuration
# Copy this file to .env and fill in your local values.
# OS environment variables override values loaded from .env.

STOCKS_HOST=127.0.0.1
STOCKS_PORT=8790

# v3.3.0 decision: SSI is primary; Vnstock Community is fallback.
STOCKS_PROVIDER_PRIMARY=ssi
STOCKS_PROVIDER_FALLBACK=vnstock
STOCKS_REQUEST_TIMEOUT=15
STOCKS_DEFAULT_LIMIT=300
STOCKS_MAX_LIMIT=2000

# PostgreSQL
STOCKS_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/stocks_data
STOCKS_DB_CONNECT_TIMEOUT=5

# SSI FastConnect Data REST
# Keep real credentials only in .env; never commit them.
SSI_CONSUMER_ID=
SSI_CONSUMER_SECRET=
SSI_PUBLIC_KEY=
SSI_PRIVATE_KEY=
SSI_DATA_BASE_URL=https://fc-data.ssi.com.vn/api/v2/Market
SSI_REQUEST_TIMEOUT=20
SSI_TOKEN_CACHE_SECONDS=1800

# Vnstock Community fallback / rate-limit protection
VNSTOCK_REQUESTS_PER_MINUTE=8
VNSTOCK_RATE_LIMIT_RETRY_SECONDS=70
VNSTOCK_RATE_LIMIT_MAX_RETRIES=5

# SSI resilience for bulk backfill
SSI_REQUEST_RETRIES=2
SSI_RETRY_DELAY_SECONDS=1
SSI_SECURITIES_CACHE_SECONDS=300

# Minimum D1 candles required before a stock is considered prepared for signals.
STOCKS_MIN_PREPARED_CANDLES=100
